# Environment & Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ksi_gadgets
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Email Configuration
# Set EMAIL_PROVIDER to "resend" (recommended) or "smtp" (fallback)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP fallback configuration (used when EMAIL_PROVIDER=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@ksi-gadgets.com

# Optional: Force all outbound emails to a single inbox (useful for testing)
EMAIL_FORCE_TO=

# Client URL(s) used for reset password links, redirects, and CORS.
# You can provide multiple origins separated by commas.
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Stripe Payment Configuration
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Get webhook secret after creating webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Coinbase Commerce Configuration
# Get your API key from: https://commerce.coinbase.com/dashboard/settings
COINBASE_API_KEY=your_coinbase_commerce_api_key_here
# Get webhook secret after creating webhook endpoint
COINBASE_WEBHOOK_SECRET=your_coinbase_webhook_secret_here

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=debug

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
